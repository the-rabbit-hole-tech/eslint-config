#!/usr/bin/env bash
# Git commit-msg hook (enforcement). Rejects AI-tells or emoji anywhere in the
# message.
#
# Conventional Commit titles are not checked here: commitlint already does
# that in this repo, and two implementations of one rule drift apart. This is
# only the part commitlint has no opinion about.
#
# Invoked from .husky/commit-msg rather than .git/hooks/, because husky points
# core.hooksPath at .husky/_ and git therefore ignores .git/hooks entirely --
# which is why the machine's global hook never ran here and an attribution
# trailer walked straight in.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
# shellcheck source=/dev/null
source "$ROOT/.claude/hooks/lib.sh"

msg_file="$1"

tells="$(gov_find_text_tells < "$msg_file")"
emoji="$(gov_find_emoji < "$msg_file")"
if [ -n "$tells$emoji" ]; then
  echo "commit-msg: AI-tell or emoji not allowed in commit message:" >&2
  [ -n "$tells" ] && echo "$tells" >&2
  [ -n "$emoji" ] && echo "$emoji" >&2
  exit 1
fi
exit 0
